{
  "rules": {
    "_readme": {
      ".read": false, ".write": false
    },

    "members": {
      ".read": "auth != null",
      "$k": {
        ".write": "auth != null && $k === auth.token.email.replace('.','_').replace('@','_')",
        ".validate": "!newData.hasChild('password') && ((!newData.hasChild('isAdmin') && !data.hasChild('isAdmin')) || newData.child('isAdmin').val() === data.child('isAdmin').val() || (!data.child('isAdmin').exists() && newData.child('isAdmin').val() === false))"
      }
    },

    "dms": {
      ".read": "auth != null",
      "$conv": {
        ".write": "auth != null && $conv.contains(auth.token.email.replace('.','_').replace('@','_'))"
      }
    },

    "track-progress": {
      "$k": {
        ".read": "auth != null && $k === auth.token.email.replace('.','_').replace('@','_')",
        ".write": "auth != null && $k === auth.token.email.replace('.','_').replace('@','_')"
      }
    },

    "submissions": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true",
      "$k": {
        ".write": "auth != null && $k === auth.token.email.replace('.','_').replace('@','_')"
      }
    },

    "vote-records": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true",
      "$k": {
        ".write": "auth != null && $k === auth.token.email.replace('.','_').replace('@','_')"
      }
    },

    "messages":      { ".read": "auth != null", ".write": "auth != null" },
    "vote-counts":   { ".read": "auth != null", ".write": "auth != null" },
    "vote-window":   { ".read": "auth != null", ".write": "auth != null" },
    "vote-history":  { ".read": "auth != null", ".write": "auth != null" },
    "custom-topics": { ".read": "auth != null", ".write": "auth != null" },
    "pending-topics":{ ".read": "auth != null", ".write": "auth != null" },
    "activity":      { ".read": "auth != null", ".write": "auth != null" },
    "notifications": { ".read": false,          ".write": "auth != null" },

    "placements":        { ".read": true, ".write": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true" },
    "placement-pending": { ".read": "auth != null", ".write": "auth != null" },

    "decks":         { ".read": true,  ".write": false },
    "flyers":        { ".read": true,  ".write": false },
    "ai-usage-tutor": { ".read": false, ".write": false },
    "config":         { ".read": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true", ".write": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true" },
    "ai-usage":      { ".read": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true", ".write": false },
    "ai-health":     { ".read": "auth != null && root.child('members').child(auth.token.email.replace('.','_').replace('@','_')).child('isAdmin').val() === true", ".write": false },
    "admin":         { ".read": false, ".write": false }
  }
}
