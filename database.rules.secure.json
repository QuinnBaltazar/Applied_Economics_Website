{
  "rules": {
    "_comment": "TARGET STATE — do not deploy until every page authenticates via Firebase Auth. Deploying this against the current localStorage client will break the site.",

    "members": {
      ".read": "auth != null && auth.token.email.endsWith('@ucsb.edu')",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        "password": { ".read": false, ".write": false },
        "phone": {
          ".read": "auth != null && auth.uid == $uid",
          ".write": "auth != null && auth.uid == $uid"
        }
      }
    },

    "messages": {
      ".read": "auth != null && auth.token.email.endsWith('@ucsb.edu')",
      "$msg": {
        ".write": "auth != null && (!data.exists() || data.child('uid').val() == auth.uid)",
        ".validate": "newData.hasChildren(['uid','text','at']) && newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 2000"
      }
    },

    "dms": {
      "$conv": {
        ".read": "auth != null && $conv.contains(auth.token.email.replace('.','_').replace('@','_'))",
        ".write": "auth != null && $conv.contains(auth.token.email.replace('.','_').replace('@','_'))"
      }
    },

    "track-progress": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    "vote-counts":   { ".read": "auth != null", ".write": false },
    "vote-records":  {
      ".read": "auth != null && auth.token.email.endsWith('@ucsb.edu')",
      "$uid": { ".write": "auth != null && auth.uid == $uid && !data.exists()" }
    },
    "vote-window":   { ".read": "auth != null", ".write": false },
    "custom-topics": { ".read": "auth != null", ".write": "auth != null" },
    "pending-topics":{ ".read": false, ".write": "auth != null" },
    "activity":      { ".read": false, ".write": "auth != null" },
    "notifications": { ".read": false, ".write": "auth != null" }
  }
}
